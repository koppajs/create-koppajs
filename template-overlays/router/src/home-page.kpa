[template]
  <section class="page">
    <div class="page-copy">
      <p class="eyebrow">Home route</p>
      <h1>KoppaJS router starter</h1>
      <p>
        This page is rendered for <code>/</code>. The counter stays here so the
        starter shows component state and route rendering in the same small app.
      </p>

      <a data-route="/router" href="/router" class="page-link">Open router page</a>
    </div>

    <counter-component></counter-component>
  </section>
[/template]

[css]
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: start;
  }

  .page-copy {
    display: grid;
    gap: 1rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  p {
    max-width: 58ch;
    color: var(--muted);
    line-height: 1.7;
  }

  code {
    color: var(--accent);
  }

  .page-link {
    width: fit-content;
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .page {
      grid-template-columns: 1fr;
    }
  }
[/css]
