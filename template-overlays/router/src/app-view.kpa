[template]
  <div class="app-shell">
    <header class="app-header">
      <img src="/koppajs-logo.png" width="280" alt="KoppaJS Logo" class="logo">

      <nav class="main-nav" aria-label="Primary">
        <a data-route="/" href="/" class="nav-link">Home</a>
        <a data-route="/router" href="/router" class="nav-link">Router</a>
      </nav>
    </header>

    <main id="app-outlet" class="app-outlet" aria-live="polite"></main>
  </div>
[/template]

[css]
  .app-shell {
    width: min(920px, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    width: min(280px, 56vw);
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.is-active,
  .nav-link[aria-current="page"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .app-outlet {
    padding-top: 2rem;
  }

  @media (max-width: 640px) {
    .app-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
[/css]
