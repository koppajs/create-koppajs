{
  "name": "__PROJECT_NAME__",
  "version": "1.0.0",
  "private": true,
  "description": "KoppaJS router application scaffolded with create-koppajs.",
  "keywords": [
    "koppajs",
    "koppa",
    "starter",
    "scaffold",
    "vite",
    "typescript",
    "web-components",
    "router"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview"
  },
  "dependencies": {
    "@koppajs/koppajs-core": "3.0.7",
    "@koppajs/koppajs-router": "0.1.6"
  },
  "devDependencies": {
    "@koppajs/koppajs-vite-plugin": "1.0.4",
    "@types/node": "25.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
