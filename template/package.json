{
  "name": "__PROJECT_NAME__",
  "version": "1.0.0",
  "private": true,
  "description": "KoppaJS application scaffolded with create-koppajs.",
  "keywords": [
    "koppajs",
    "koppa",
    "starter",
    "scaffold",
    "vite",
    "typescript",
    "web-components"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.24.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview"
  },
  "dependencies": {
    "@koppajs/koppajs-core": "3.0.7"
  },
  "devDependencies": {
    "@koppajs/koppajs-vite-plugin": "1.0.4",
    "@types/node": "25.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
